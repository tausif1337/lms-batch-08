# Copy this file to .env.local and edit it if your backend is not on the
# default address. Vite only exposes variables that start with VITE_.
#
# .env.local is ignored by git (see .gitignore, "*.local"), so it is the right
# place for anything machine-specific.

# Where the Django API lives. Note the /api on the end: every path in
# src/api.js is written relative to it.
VITE_API_URL=http://127.0.0.1:8001/api
